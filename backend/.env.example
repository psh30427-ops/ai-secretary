# Firebase 서비스 계정 JSON 파일 전체를 base64로 인코딩한 한 줄 문자열 (README 참고)
FIREBASE_CREDENTIALS_BASE64=

# OpenAI
OPENAI_API_KEY=
# 사용할 모델 이름. 기본값이 없으니 반드시 직접 설정하세요.
OPENAI_MODEL=
# 비우면 OpenAI를 사용. 제미나이를 쓰려면 아래 주소를 넣고, OPENAI_API_KEY에 제미나이 API 키,
# OPENAI_MODEL에 제미나이 모델 이름을 넣으세요.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=

# CORS 허용 출처 (쉼표 구분). 비워 두면 로컬 개발용 주소만 허용됩니다.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
